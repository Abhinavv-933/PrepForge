# ==========================================
# Server
# ==========================================

# Express server port
PORT=5000

# development | production | test
NODE_ENV=development


# ==========================================
# Database
# ==========================================

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>


# ==========================================
# Authentication
# ==========================================

# Long random secret used to sign JWTs.
# Never commit the actual value.
JWT_SECRET=replace-with-a-long-random-secret


# ==========================================
# Frontend / CORS
# ==========================================

# Local frontend origin
CLIENT_ORIGIN=http://localhost:3000


# ==========================================
# LLM Providers
# ==========================================

# Gemini API key
GEMINI_API_KEY=

# Groq API key
GROQ_API_KEY=


# ==========================================
# External URL Retrieval
# ==========================================

# Set true ONLY for local assessment test sites.
# Production should remain false.
ALLOW_PRIVATE_URLS=false


# ==========================================
# Authentication Cookie
# ==========================================

# true in production when using HTTPS
COOKIE_SECURE=false

# strict | lax | none
COOKIE_SAME_SITE=lax